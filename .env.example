# LingLang — example environment
#
# Copy to agents/.env.local and fill in. Everything in REQUIRED must be set
# for a cloud-mode install; everything below it has a working default or is
# only read by an optional subsystem.
#
# Cloud mode is the supported self-host path: Postgres + this agent + a
# LiveKit project + one Google API key. No GPU. Local mode additionally
# needs the speech stack (Qwen3-ASR, MOSS-TTS, a llama.cpp server), which
# is NOT part of this repository — see LOCAL MODE at the bottom.

# ─────────────────────────── REQUIRED ───────────────────────────

# Postgres with the pgvector extension. `docker compose up -d` brings up a
# matching instance on 5433 and this default points at it.
DATABASE_URL=postgresql://linglang:linglang_dev@localhost:5433/linglang

# LiveKit — carries the audio. Either LiveKit Cloud (free tier is enough to
# start; create a project and copy its keys) or a self-hosted livekit-server.
# The secret signs room tokens for every session: it is per-deployment
# infrastructure, never a per-user setting, and must never reach a browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google API key for Gemini. In cloud mode this is the model that talks,
# listens and speaks, so nothing works without it.
GEMINI_API_KEY=

# Encrypts per-user API keys at rest (users may bring their own Google key).
# lib/crypto.ts THROWS if this is unset, so an install without it dies the
# first time anyone saves a key. Generate a unique one:
#   openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=

# Salt for dashboard password hashing. There IS a default in the source, but
# it is a fixed public string — every install that leaves this blank shares
# it. Always set your own:
#   openssl rand -hex 16
DASHBOARD_PASSWORD_SALT=

# ─────────────────────────── COMMON ───────────────────────────

# 'cloud' runs the realtime Google model end to end. 'local' needs the GPU
# speech stack below. New installs should stay on cloud.
SERVICE_MODE=cloud

DASHBOARD_PORT=3001

# Language a brand-new account starts on, before onboarding sets a real one.
DEFAULT_TARGET_LANGUAGE=es
DEFAULT_NATIVE_LANGUAGE=en

# Needed only when the dashboard is served from a different origin than the
# API (e.g. a separate marketing site embedding the demo).
# CORS_ALLOWED_ORIGINS=https://example.com
# CROSS_ORIGIN_COOKIES=false

# Must match the agent name the dashboard dispatches jobs to. Change both or
# neither.
LINGLANG_AGENT_NAME=linglang-tutor

# ─────────────────────── ANONYMOUS DEMO (optional) ───────────────────────
# Only needed if you expose a public no-signup demo. Sessions are capped and
# billed against a shared key budget.

# DEMO_SESSION_TIME_LIMIT_MS=300000
# DEMO_OPENING_LINE=
# GOOGLE_SHARED_KEY_LIMIT_MICROS=1000000   # $1.00 per period
# GOOGLE_USAGE_RESET_DAYS=30

# ───────────────────── LOCAL MODE (advanced, GPU) ─────────────────────
# Unsupported for self-hosting today: these point at services that do not
# ship with this repo and must be running before SERVICE_MODE=local will
# start. Listed so the defaults are at least discoverable.

# LOCAL_LLM_URL=http://localhost:11434/v1      # llama.cpp / ollama
# LOCAL_STT_URL=http://localhost:8000/v1
# LOCAL_TTS_URL=http://localhost:8880
# QWEN3_ASR_URL=http://localhost:8092
# OMNIVOICE_TTS_URL=http://localhost:8882
# EMBED_URL=http://localhost:8091/v1/embeddings

# Per-role model overrides. Each falls back to LOCAL_LLM_URL when unset.
# CONVERSATION_LLM_URL=
# PROCESSOR_LLM_URL=
# SUPERVISOR_LLM_URL=

# ─────────────────── ALTERNATIVE PROVIDERS (optional) ───────────────────
# Only read when the corresponding service is selected.

# ELEVENLABS_API_KEY=
# MINIMAX_API_KEY=
# GROQ_API_KEY=
# OPENSUBTITLES_API_KEY=       # content ingestion only

# LOG_LEVEL=info
