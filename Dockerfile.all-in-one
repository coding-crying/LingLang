# Experimental full-product packaging; not a published release.
FROM node:22-trixie-slim AS node
FROM python:3.13-slim-trixie
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && npm install -g pnpm@9.7.0 \
 && apt-get update && apt-get install -y --no-install-recommends postgresql-17 postgresql-17-pgvector gosu build-essential \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 linglang
ENV PYTHONUNBUFFERED=1 PATH="/usr/lib/postgresql/17/bin:/opt/venv/bin:${PATH}"
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir 'pipecat-ai[google,openai,webrtc,runner,livekit]==1.7.0' aiohttp fastapi uvicorn python-dotenv
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile \
 && npm --prefix agents/src/dashboard/frontend ci --legacy-peer-deps \
 && pnpm --dir agents dashboard:build \
 && cd agents && pnpm exec drizzle-kit generate --dialect postgresql --schema ./src/db/schema.ts --out /opt/initial-schema
ENV LINGLANG_VOICE_ENABLED=1 LINGLANG_PROVIDER_POLICY=user SERVICE_MODE=gemini PORT=3000
EXPOSE 3000
VOLUME ["/data"]
HEALTHCHECK --interval=15s --timeout=3s --start-period=90s \
 CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:3000/login', timeout=2); urlopen('http://127.0.0.1:7860/client/', timeout=2)"
CMD ["python", "/app/deploy/all-in-one/runtime.py"]
